/**
 * @param {number} n
 * @return {string[]}
 */
var fizzBuzz = function(n) {
    let arr=[]
    let fizz="Fizz"
    let Buzz="Buzz"
    let fizzBuzz="FizzBuzz"
for(let i=1;i<=n;i++){
     if(i%3 ===0 && i%5 ===0){
     arr.push(fizzBuzz)
    
    }
    else if(i%3 ===0) {
       arr.push(fizz)
    }
    else if(i%5 ===0){
 arr.push(Buzz)
    }else{
     let a=i.toString()
     arr.push(a)
    }
     
}    
return arr
};
